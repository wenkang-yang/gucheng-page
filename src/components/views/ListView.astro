---
import { render } from 'astro:content'

import Categorizer from '~/components/base/Categorizer.astro'
import DesktopAside from '~/components/base/DesktopAside.astro'
import EmptyState from '~/components/base/EmptyState.astro'
import MobileControl from '~/components/base/MobileControl.astro'
import ListItem from '~/components/views/ListItem.astro'

import { FEATURES } from '~/config'
import { getYear } from '~/utils/datetime'
import { getFilteredPosts, getMinutesRead, getSortedPosts } from '~/utils/data'

import type { CollectionEntry } from 'astro:content'

interface Props {
  collectionType: 'writing'
  pageToc?: boolean
  pageTag?: boolean
}

const { collectionType, pageToc = false, pageTag = false } = Astro.props

const { toc, tag } = FEATURES
const tocEnabled = Array.isArray(toc) && toc[0] && pageToc
const tagEnabled = Array.isArray(tag) && tag[0] && pageTag

const groupedItems: {
  year: string
  items: {
    idx: number
    id: CollectionEntry<'writing'>['id']
    data: CollectionEntry<'writing'>['data']
    minutesRead: number
  }[]
}[] = []

const posts = getSortedPosts(await getFilteredPosts(collectionType))
const enriched = await Promise.all(
  posts.map(async (post, idx) => {
    const { remarkPluginFrontmatter } = await render(post)

    return {
      idx,
      id: post.id,
      data: post.data,
      year: getYear(post.data.pubDate).toString(),
      minutesRead: getMinutesRead(
        post.data.minutesRead,
        remarkPluginFrontmatter.minutesRead
      ),
    }
  })
)

for (const item of enriched) {
  const last = groupedItems[groupedItems.length - 1]
  if (!last || last.year !== item.year) {
    groupedItems.push({ year: item.year, items: [item] })
  } else {
    last.items.push(item)
  }
}

const years = tocEnabled ? groupedItems.map(({ year }) => year) : []
const tags = tagEnabled
  ? enriched.map(({ data }) => data.tags).filter((tags) => tags.length > 0)
  : []
---

<DesktopAside anchors={years} {tags} />
<MobileControl anchors={years} {tags} />

<div aria-label="文章列表">
  {
    groupedItems.length === 0 ? (
      <EmptyState
        title="文章正在酝酿"
        description="这里会放相对完整的写作、技术思考与阶段性总结。"
      />
    ) : (
      groupedItems.map((group) => {
        const idx = group.items[0].idx

        return (
          <section
            class="[&:not(:has([data-tags]:not(.hidden)))]:hidden"
            data-year={group.year}
          >
            <Categorizer {idx} needId={tocEnabled} text={group.year} />

            {group.items.map(({ data, id, minutesRead, idx }) => (
              <ListItem
                {idx}
                collectionType="writing"
                postSlug={id}
                title={data.title}
                tags={data.tags}
                date={data.pubDate}
                {minutesRead}
                radio={data.radio}
                video={data.video}
                platform={data.platform}
                redirect={data.redirect}
              />
            ))}
          </section>
        )
      })
    )
  }
</div>
