---
import { withBasePath } from '~/utils/path'

const topics = [
  '电子信息',
  '计算机系统',
  '人工智能',
  '嵌入式技术',
  '文学与历史',
]

const sections = [
  {
    href: '/projects',
    title: 'Projects',
    description: '做过的项目与技术实践',
  },
  {
    href: '/writing',
    title: 'Writing',
    description: '相对完整的文章与思考',
  },
  {
    href: '/notes',
    title: 'Notes',
    description: '学习记录与灵感片段',
  },
  {
    href: '/photos',
    title: 'Photos',
    description: '旅途、校园与日常画面',
  },
  {
    href: '/library',
    title: 'Library',
    description: '藏卷 · 读过的书、教材与论文',
  },
]
---

<section class="home-overview" aria-label="网站内容入口">
  <div class="topics" aria-label="关注领域">
    {topics.map((topic) => <span>{topic}</span>)}
  </div>

  <div class="section-heading">
    <span>在这里</span>
    <span class="section-heading__line" aria-hidden="true"></span>
  </div>

  <nav class="section-grid" aria-label="主要栏目">
    {
      sections.map((section) => (
        <a
          class:list={[
            'section-card',
            { 'section-card--wide': section.href === '/library' },
          ]}
          href={withBasePath(section.href)}
        >
          <span>
            <strong>{section.title}</strong>
            <small>{section.description}</small>
          </span>
          <span class="section-card__arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))
    }
  </nav>

  <div class="contact-links" aria-label="联系方式">
    <div class="contact-row">
      <span>GitHub：</span>
      <a href="https://github.com/wenkang-yang">wenkang-yang</a>
    </div>
    <div class="contact-row">
      <span>联系方式：</span>
      <a href="mailto:3441962884@qq.com">3441962884@qq.com</a>
    </div>
  </div>
</section>

<style>
  .home-overview {
    margin-top: 2.25rem;
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .topics span {
    padding: 0.3rem 0.7rem;
    border: 1px solid rgb(127 127 127 / 0.2);
    border-radius: 999px;
    background: rgb(127 127 127 / 0.055);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    opacity: 0.72;
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 2.5rem;
    font-family: var(--font-serif);
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    opacity: 0.55;
  }

  .section-heading__line {
    flex: 1;
    height: 1px;
    background: rgb(127 127 127 / 0.2);
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .section-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid rgb(127 127 127 / 0.18);
    border-radius: 0.8rem;
    color: inherit;
    background: color-mix(in srgb, var(--c-bg) 72%, transparent);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      background-color 180ms ease;
  }

  .section-card--wide {
    grid-column: 1 / -1;
  }

  .section-card:hover,
  .section-card:focus-visible {
    border-color: rgb(127 127 127 / 0.38);
    background: rgb(127 127 127 / 0.07);
    transform: translateY(-2px);
  }

  .section-card span:first-child {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .section-card strong {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    letter-spacing: 0.04em;
  }

  .section-card small {
    font-size: 0.75rem;
    line-height: 1.5;
    opacity: 0.52;
  }

  .section-card__arrow {
    flex: none;
    font-size: 0.9rem;
    opacity: 0.38;
    transition: opacity 180ms ease;
  }

  .section-card:hover .section-card__arrow,
  .section-card:focus-visible .section-card__arrow {
    opacity: 0.8;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: 2.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(127 127 127 / 0.18);
    font-size: 0.82rem;
    opacity: 0.58;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    gap: 0.15rem;
    line-height: 1.7;
  }

  .contact-links a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 34rem) {
    .section-grid {
      grid-template-columns: 1fr;
    }

    .section-card--wide {
      grid-column: auto;
    }
  }
</style>
