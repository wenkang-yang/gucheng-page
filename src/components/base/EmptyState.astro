---
interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
---

<section class="empty-state" aria-label={title}>
  <div class="empty-state__mark" aria-hidden="true">·</div>
  <h2>{title}</h2>
  <p>{description}</p>
</section>

<style>
  .empty-state {
    margin: 2rem auto 0;
    max-width: 34rem;
    padding: 2.5rem 1.5rem;
    text-align: center;
    color: color-mix(in srgb, currentColor 62%, transparent);
  }

  .empty-state__mark {
    margin-bottom: 0.75rem;
    font-family: var(--font-serif);
    font-size: 2.5rem;
    line-height: 1;
  }

  h2 {
    margin: 0;
    color: color-mix(in srgb, currentColor 82%, transparent);
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  p {
    margin: 0.65rem 0 0;
    font-size: 0.92rem;
    line-height: 1.8;
  }
</style>
